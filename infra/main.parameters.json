{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "deployerPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "modelRevision": {
      "value": "${APERTUS_MODEL_REVISION}"
    },
    "applicationSecretsReady": {
      "value": "${APPLICATION_SECRETS_READY=false}"
    },
    "webIqSecretReady": {
      "value": "${WEBIQ_SECRET_READY=false}"
    },
    "rotateApplicationSecrets": {
      "value": "${ROTATE_APPLICATION_SECRETS=false}"
    },
    "rotateWebIqSecret": {
      "value": "${ROTATE_WEBIQ_SECRET=false}"
    },
    "rotateVllmSecret": {
      "value": "${ROTATE_VLLM_SECRET=false}"
    },
    "entraClientId": {
      "value": "${ENTRA_CLIENT_ID}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID}"
    },
    "alertEmail": {
      "value": "${ALERT_EMAIL}"
    },
    "monthlyBudgetAmount": {
      "value": "${MONTHLY_BUDGET_AMOUNT=500}"
    },
    "budgetStartDate": {
      "value": "${BUDGET_START_DATE=}"
    },
    "containerRegistryName": {
      "value": "${AZURE_CONTAINER_REGISTRY_NAME=}"
    },
    "storageAccountName": {
      "value": "${AZURE_STORAGE_ACCOUNT_NAME=}"
    },
    "keyVaultName": {
      "value": "${AZURE_KEY_VAULT_NAME=}"
    },
    "contentSafetyAccountName": {
      "value": "${AZURE_CONTENT_SAFETY_ACCOUNT_NAME=}"
    },
    "huggingFaceToken": {
      "value": "${HF_TOKEN}"
    },
    "vllmApiKey": {
      "value": "${VLLM_API_KEY=}"
    },
    "modelHealthToken": {
      "value": "${MODEL_HEALTH_TOKEN=}"
    },
    "entraClientSecret": {
      "value": "${ENTRA_CLIENT_SECRET}"
    },
    "webIqApiKey": {
      "value": "${WEBIQ_API_KEY=}"
    }
  }
}